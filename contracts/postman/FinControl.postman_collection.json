  "item": [
    {
      "name": "auth",
      "item": [
        {"name": "login_400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('400', () => { pm.response.to.have.status(400); const b = pm.response.json(); pm.expect(b.codigoErro).to.eql('VALIDACAO'); pm.expect(b.erros.length).to.be.above(0); pm.expect(b.erros[0]).to.have.property('campo'); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"]}}]},
        {"name": "login_401_inexistente", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"nao-existe@fincontrol.local\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); const b = pm.response.json(); pm.expect(b.codigoErro).to.eql('NAO_AUTENTICADO'); pm.expect(b.detail).to.eql('Não autenticado.'); pm.expect(b.detail).to.not.include('Exception'); });"]}}]},
        {"name": "login_401_inativo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailInativo}}\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); pm.expect(pm.response.json().detail).to.eql('Não autenticado.'); });"]}}]},
        {"name": "login_401_cliente_inativo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailClienteInativo}}\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().detail).to.eql('Não autenticado.'); });"]}}]},
        {"name": "login_401_senha", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailUsuario}}\",\"senha\":\"senha-errada\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().detail).to.eql('Não autenticado.'); });"]}}]},
        {"name": "login_200_master", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailMaster}}\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b = pm.response.json(); const p = JSON.parse(atob(b.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.test('200', () => { pm.response.to.have.status(200); pm.expect(p.iss).to.eql('fincontrol'); pm.expect(p.role).to.eql('MASTER'); pm.expect(p.clienteId).to.be.undefined; pm.expect(p.jti).to.match(/^[0-9a-f-]{36}$/i); pm.expect(p.nbf).to.eql(p.iat); pm.expect(p.exp - p.iat).to.eql(900); pm.expect(Object.keys(p).sort()).to.eql(['exp','iat','iss','jti','nbf','role','sub']); pm.expect(Object.keys(b).sort()).to.eql(['accessToken','expiresIn','tokenType']); pm.environment.set('accessMaster', b.accessToken); pm.environment.set('subMaster', p.sub); });"]}}]},
        {"name": "me_200_master", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessMaster}}"}], "url": "{{baseUrl}}/api/v1/auth/me"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.role).to.eql('MASTER'); pm.expect(b.clienteId).to.eql(null); pm.expect(b.id).to.eql(pm.environment.get('subMaster')); pm.expect(b).to.not.have.property('senha'); });"]}}]},
        {"name": "login_200", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailUsuario}}\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b = pm.response.json(); const p = JSON.parse(atob(b.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); const cookie = pm.response.headers.get('Set-Cookie'); pm.test('200', () => { pm.response.to.have.status(200); pm.expect(p.role).to.eql('ADMIN'); pm.expect(p.clienteId).to.be.a('string'); pm.expect(p.iss).to.eql('fincontrol'); pm.expect(p.exp - p.iat).to.eql(900); pm.expect(cookie).to.include('HttpOnly'); pm.expect(cookie).to.include('SameSite=Strict'); pm.expect(cookie).to.include('Path=/api/v1/auth'); pm.environment.set('accessUsuario', b.accessToken); pm.environment.set('subUsuario', p.sub); pm.environment.set('clienteUsuario', p.clienteId); pm.environment.set('refreshUsuario', cookie.split(';')[0].substring('refresh_token='.length)); });"]}}]},
        {"name": "me_200", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessUsuario}}"}], "url": "{{baseUrl}}/api/v1/auth/me"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('200', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.id).to.eql(pm.environment.get('subUsuario')); pm.expect(b.role).to.eql('ADMIN'); pm.expect(b.clienteId).to.eql(pm.environment.get('clienteUsuario')); pm.expect(b.email).to.eql(pm.environment.get('emailUsuario')); });"]}}]},
        {"name": "login_200_mae", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailMae}}\",\"senha\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const p = JSON.parse(atob(pm.response.json().accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.test('200', () => { pm.response.to.have.status(200); pm.expect(p.role).to.eql('ADMIN'); pm.expect(p.clienteId).to.not.eql(pm.environment.get('clienteUsuario')); });"]}}]},
        {"name": "criarCliente_401", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nomeCliente\":\"X\",\"nomeAdministrador\":\"Y\",\"emailAdministrador\":\"y@fincontrol.local\",\"senhaAdministrador\":\"segredo123\"}"}, "url": "{{baseUrl}}/api/v1/master/clientes"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]},
        {"name": "criarCliente_403", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessUsuario}}"}], "body": {"mode": "raw", "raw": "{\"nomeCliente\":\"X\",\"nomeAdministrador\":\"Y\",\"emailAdministrador\":\"y@fincontrol.local\",\"senhaAdministrador\":\"segredo123\"}"}, "url": "{{baseUrl}}/api/v1/master/clientes"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('403', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().codigoErro).to.eql('ACESSO_NEGADO'); });"]}}]},
        {"name": "criarCliente_400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessMaster}}"}], "body": {"mode": "raw", "raw": "{\"nomeCliente\":\"\",\"nomeAdministrador\":\"Y\",\"emailAdministrador\":\"nao-email\",\"senhaAdministrador\":\"curta\"}"}, "url": "{{baseUrl}}/api/v1/master/clientes"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().codigoErro).to.eql('VALIDACAO'); pm.expect(pm.response.json().erros.length).to.be.above(0); });"]}}]},
        {"name": "criarCliente_201", "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.environment.set('emailNovo', 'novo-' + Date.now() + '@fincontrol.local');"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('201', () => { pm.response.to.have.status(201); const b = pm.response.json(); pm.expect(b.clienteId).to.be.a('string'); pm.expect(b.administradorId).to.be.a('string'); pm.expect(b).to.not.have.property('senha'); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessMaster}}"}], "body": {"mode": "raw", "raw": "{\"nomeCliente\":\"Novo\",\"nomeAdministrador\":\"Novo Admin\",\"emailAdministrador\":\"{{emailNovo}}\",\"senhaAdministrador\":\"{{senha}}\"}"}, "url": "{{baseUrl}}/api/v1/master/clientes"}},
        {"name": "login_429", "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["function falhar(n){ if(n===0){return;} pm.sendRequest({url: pm.environment.get('baseUrl')+'/api/v1/auth/login', method:'POST', header:{'Content-Type':'application/json'}, body:{mode:'raw', raw: JSON.stringify({email: pm.environment.get('emailNovo'), senha:'errada-demais'})}}, function(){ falhar(n-1); }); } falhar(4);"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('429', () => { pm.response.to.have.status(429); pm.expect(pm.response.json().codigoErro).to.eql('LOGIN_BLOQUEADO'); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{emailNovo}}\",\"senha\":\"errada-demais\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}},
        {"name": "refreshToken_200", "request": {"method": "POST", "header": [{"key": "Cookie", "value": "refresh_token={{refreshUsuario}}"}], "url": "{{baseUrl}}/api/v1/auth/refresh_token"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const b = pm.response.json(); const p = JSON.parse(atob(b.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); const antigo = JSON.parse(atob(pm.environment.get('accessUsuario').split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); const cookie = pm.response.headers.get('Set-Cookie'); pm.test('200', () => { pm.response.to.have.status(200); pm.expect(p.jti).to.not.eql(antigo.jti); pm.expect(p.sub).to.eql(antigo.sub); pm.environment.set('accessAntigo', pm.environment.get('accessUsuario')); pm.environment.set('refreshAntigo', pm.environment.get('refreshUsuario')); pm.environment.set('accessUsuario', b.accessToken); pm.environment.set('refreshUsuario', cookie.split(';')[0].substring('refresh_token='.length)); });"]}}]},
        {"name": "refreshToken_401_reuso", "request": {"method": "POST", "header": [{"key": "Cookie", "value": "refresh_token={{refreshAntigo}}"}], "url": "{{baseUrl}}/api/v1/auth/refresh_token"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]},
        {"name": "me_401_revogado", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessAntigo}}"}], "url": "{{baseUrl}}/api/v1/auth/me"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]},
        {"name": "me_401_ausente", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/auth/me"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]},
        {"name": "me_401_adulterado", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer aaa.bbb.ccc"}], "url": "{{baseUrl}}/api/v1/auth/me"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); });"]}}]},
        {"name": "logout_401", "request": {"method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]},
        {"name": "logout_204", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{accessUsuario}}"}, {"key": "Cookie", "value": "refresh_token={{refreshUsuario}}"}], "url": "{{baseUrl}}/api/v1/auth/logout"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('204', () => { pm.response.to.have.status(204); pm.expect(pm.response.headers.get('Set-Cookie')).to.include('Max-Age=0'); });"]}}]},
        {"name": "refreshToken_401_ausente", "request": {"method": "POST", "header": [{"key": "Cookie", "value": "refresh_token={{refreshUsuario}}"}], "url": "{{baseUrl}}/api/v1/auth/refresh_token"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('401', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().codigoErro).to.eql('NAO_AUTENTICADO'); });"]}}]}
