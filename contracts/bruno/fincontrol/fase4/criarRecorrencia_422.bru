meta {
  name: criarRecorrencia_422
  type: http
  seq: 56
}

post {
  url: {{baseUrl}}/api/v1/recorrencias
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"contaId":"{{idContaFlash}}","categoriaId":"{{idCategoriaBeneficios}}","natureza":"RECEITA","valor":"1570.00","descricao":"{{nomeRecorrencia}}","diaDoMes":0}
}

script:post-response {
  expect(res.getStatus()).to.equal(422);
  expect(res.getBody().codigoErro).to.equal('NOME_EM_USO');
}
