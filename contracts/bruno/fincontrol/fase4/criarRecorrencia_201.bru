meta {
  name: criarRecorrencia_201
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/v1/recorrencias
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"contaId":"{{idContaFlash}}","categoriaId":"{{idCategoriaBeneficios}}","natureza":"RECEITA","valor":"1570.00","descricao":"Benefício Flash {{$timestamp}}","diaDoMes":0}
}

script:post-response {
  expect(res.getStatus()).to.equal(201);
  bru.setVar('idRecorrencia', res.getBody().id);
}
