meta {
  name: atualizarLancamento_422
  type: http
  seq: 38
}

put {
  url: {{baseUrl}}/api/v1/lancamentos/{{idLancamento}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"contaId":"{{idConta}}","categoriaId":"{{idCategoria}}","natureza":"DESPESA","tipoDespesa":"VARIAVEL","valor":"100.00","data":"2026-11-13","descricao":"Compra","parcelas":1}
}

script:post-response {
  expect(res.getStatus()).to.equal(422);
  expect(res.getBody().codigoErro).to.equal('LANCAMENTO_ESTORNADO');
}
