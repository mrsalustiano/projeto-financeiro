meta {
  name: criarLancamento_201_abril
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/lancamentos
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"contaId":"{{idConta}}","categoriaId":"{{idCategoria}}","natureza":"DESPESA","tipoDespesa":"VARIAVEL","valor":"100.00","data":"2025-04-10","descricao":"Compra","parcelas":1}
}

script:post-response {
  expect(res.getStatus()).to.equal(201);
  bru.setVar('idAbril', res.getBody().parcelas[0].id);
}
