meta {
  name: estornarLancamento_200
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/v1/lancamentos/{{idLancamento}}/estorno
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"motivo":"engano"}
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.getBody().estornado).to.equal(true);
}
