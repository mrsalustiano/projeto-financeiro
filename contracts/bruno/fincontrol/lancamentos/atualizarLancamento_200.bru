meta {
  name: atualizarLancamento_200
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/api/v1/lancamentos/{{idLancamento}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}

body:json {
{"contaId":"{{idConta}}","categoriaId":"{{idCategoria}}","natureza":"DESPESA","tipoDespesa":"VARIAVEL","valor":"100.00","data":"2026-11-12","descricao":"Compra","parcelas":1}
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.getBody().data).to.equal('2026-11-12');
}
