meta {
  name: login_200_master
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
{ "email": "{{emailMaster}}", "senha": "{{senha}}" }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  const p = JSON.parse(Buffer.from(res.getBody().accessToken.split('.')[1], 'base64url').toString());
  expect(p.role).to.equal('MASTER');
  expect(p.clienteId).to.equal(undefined);
  bru.setVar('accessMaster', res.getBody().accessToken);
}
