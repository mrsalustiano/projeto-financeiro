meta {
  name: login_401_cliente_inativo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
{ "email": "{{emailClienteInativo}}", "senha": "{{senha}}" }
}

script:post-response {
  expect(res.getStatus()).to.equal(401);
}
