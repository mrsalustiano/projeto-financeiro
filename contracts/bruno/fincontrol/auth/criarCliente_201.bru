meta {
  name: criarCliente_201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/master/clientes
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessMaster}}
}

body:json {
{ "nomeCliente": "Novo", "nomeAdministrador": "Novo Admin", "emailAdministrador": "{{emailNovo}}", "senhaAdministrador": "{{senha}}" }
}
script:pre-request {
  bru.setVar('emailNovo', 'novo-' + Date.now() + '@fincontrol.local');
}

script:post-response {
  expect(res.getStatus()).to.equal(201);
  expect(res.getBody().clienteId).to.be.a('string');
}
