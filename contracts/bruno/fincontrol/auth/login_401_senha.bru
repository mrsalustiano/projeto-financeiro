meta {
  name: login_401_senha
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
{ "email": "{{emailUsuario}}", "senha": "senha-errada" }
}

script:post-response {
  expect(res.getStatus()).to.equal(401);
  expect(res.getBody().codigoErro).to.equal('NAO_AUTENTICADO');
}
