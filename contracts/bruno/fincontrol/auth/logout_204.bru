meta {
  name: logout_204
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
  cookie: refresh_token={{refreshUsuario}}
}


script:post-response {
  expect(res.getStatus()).to.equal(204);
}
