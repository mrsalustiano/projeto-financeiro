meta {
  name: refreshToken_200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh_token
  body: json
  auth: none
}

headers {
  content-type: application/json
  cookie: refresh_token={{refreshUsuario}}
}


script:post-response {
  expect(res.getStatus()).to.equal(200);
  const p = JSON.parse(Buffer.from(res.getBody().accessToken.split('.')[1], 'base64url').toString());
  expect(p.jti).to.be.a('string');
  bru.setVar('accessAntigo', bru.getVar('accessUsuario'));
  bru.setVar('refreshAntigo', bru.getVar('refreshUsuario'));
  bru.setVar('accessUsuario', res.getBody().accessToken);
}
