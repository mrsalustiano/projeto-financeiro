meta {
  name: me_200
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{accessUsuario}}
}


script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.getBody().role).to.equal('ADMIN');
  expect(res.getBody().clienteId).to.equal(bru.getVar('clienteUsuario'));
}
