meta {
  name: login_400
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
{ "email": "", "senha": "" }
}

script:post-response {
  expect(res.getStatus()).to.equal(400);
  expect(res.getBody().codigoErro).to.equal('VALIDACAO');
  expect(res.getBody().erros.length).to.be.above(0);
}
