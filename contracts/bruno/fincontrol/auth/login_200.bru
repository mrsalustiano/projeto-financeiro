meta {
  name: login_200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
{ "email": "{{emailUsuario}}", "senha": "{{senha}}" }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  const p = JSON.parse(Buffer.from(res.getBody().accessToken.split('.')[1], 'base64url').toString());
  expect(p.iss).to.equal('fincontrol');
  expect(p.role).to.equal('ADMIN');
  expect(p.clienteId).to.be.a('string');
  expect(p.exp - p.iat).to.equal(900);
  expect(res.getBody().refreshToken).to.be.a('string');
  bru.setVar('accessUsuario', res.getBody().accessToken);
  bru.setVar('clienteUsuario', p.clienteId);
  bru.setVar('refreshUsuario', res.getBody().refreshToken);
}
