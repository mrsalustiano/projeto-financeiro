meta {
  name: sugerirContasOfx_422
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/ofx/sugestoes
  body: multipart-form
  auth: none
}

headers {
  authorization: Bearer {{accessUsuario}}
}

body:multipart-form {
  arquivo: @file(../../../ofx/extrato.csv)
}

script:post-response {
  expect(res.getStatus()).to.equal(422);
  expect(res.getBody().codigoErro).to.equal('OFX_INVALIDO');
}
